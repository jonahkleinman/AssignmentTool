# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*-firebase-adminsdk-*.json
service-account*.json

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# knowledge base — copyrighted source material + local build artifacts stay off git
/knowledge/source/
/.cache/

# exported human eval labels stay local; the synthetic and AI baselines are reproducible artifacts
/eval/labels/*.json
!/eval/labels/toy.json
!/eval/labels/ai.json

# blind output-evaluation answer keys and reveal exports stay private
/eval/output-runs/
/eval/output-exports/
