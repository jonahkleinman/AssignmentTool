OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# --- Google Drive upload (optional) ---
# When CLIENT_ID and API_KEY are set, a "From Google Drive" button appears on
# the start screen. Leave them blank to hide it; local upload + paste work
# without them. Create credentials in Google Cloud Console:
#   - OAuth 2.0 Client ID (Web application)        -> CLIENT_ID
#       Add your dev origin (http://localhost:3000) to Authorized JS origins.
#   - API key (restricted to the Google Picker API) -> API_KEY
#   - The GCP project number                        -> APP_ID
# Also enable the "Google Picker API" and "Google Drive API" for the project.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
