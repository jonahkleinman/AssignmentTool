OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# --- Thinking model for redesign + diagnose (optional) ---
# Set OPENAI_REASONING_MODEL to an OpenAI reasoning model id to turn thinking on
# for the two reasoning-heavy routes. Leave it blank and those routes keep using
# OPENAI_MODEL above (no reasoning tokens) — identical to before. suggest/extract
# always stay on OPENAI_MODEL.
OPENAI_REASONING_MODEL=
# low | medium | high — depth of reasoning (default: medium). Ignored unless a
# reasoning model is set above.
OPENAI_REASONING_EFFORT=medium
# A/B toggle. Leave unset to use the thinking model whenever one is configured.
# Set to false to force the fast model back on WITHOUT clearing the id above, so
# you can flip arms between runs. true | false (also 1/0, on/off, yes/no).
OPENAI_USE_REASONING=

# --- Google Drive upload (optional) ---
# When CLIENT_ID and API_KEY are set, a "From Google Drive" button appears on
# the start screen. Leave them blank to hide it; local upload + paste work
# without them. Create credentials in Google Cloud Console:
#   - OAuth 2.0 Client ID (Web application)        -> CLIENT_ID
#       Add your dev origin (http://localhost:3000) to Authorized JS origins.
#   - API key (restricted to the Google Picker API) -> API_KEY
#   - The GCP project number                        -> APP_ID
# Also enable the "Google Picker API" and "Google Drive API" for the project.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=

# Private retrieval-evaluation workspace
EVAL_ACCESS_CODE=replace-with-a-long-shared-code
EVAL_LABEL_STORAGE=firestore
FIREBASE_PROJECT_ID=betterassignments-3adbe
# Local development: absolute path to the downloaded service-account JSON.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-adminsdk.json
# Hosted deployment: base64-encoded service-account JSON. Never commit its value.
FIREBASE_SERVICE_ACCOUNT_BASE64=
